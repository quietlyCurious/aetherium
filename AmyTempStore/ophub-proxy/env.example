# Copy this file to .env and fill in real values. NEVER commit .env or paste
# its contents into chat, Slack, tickets, etc. — it contains a live session
# credential for your OpHub account.

# ── Where the proxy listens ──────────────────────────────────────────────────
PORT=4000

# ── Where Aetherium's dev server runs (CORS will only allow this origin) ────
ALLOWED_ORIGIN=http://localhost:3000

# ── The real OpHub instance to forward requests to ───────────────────────────
OPHUB_BASE_URL=https://mes.gedemo.io

# ── Your OpHub session cookie ────────────────────────────────────────────────
# How to get this value:
#   1. Log into OpHub normally in your browser (mes.gedemo.io).
#   2. Open DevTools → Network tab, find any request to that domain.
#   3. Look at Request Headers → Cookie — copy the ENTIRE value (it's one
#      long string with multiple "name=value" pairs separated by "; ").
#   4. Paste the whole thing below, on one line, no quotes needed.
#
# This is a real, live credential for your account. Treat it exactly like a
# password: don't commit it, don't paste it into chat, don't share the .env
# file. It will also expire/rotate when your browser session does, at which
# point you'll need to repeat these steps to get a fresh value.
OPHUB_COOKIE=

# ── Site/management-layer cookie (needed for flow discovery / "Sync") ───────
# The "site" management layer (e.g. /site/ajax/FlowMgr, used to list all
# available flows) uses a DIFFERENT cookie than the "app" runtime layer above
# — confirmed by comparing two real requests: the site layer's cookie
# included IQP_SITE and ssm_au_c; the runtime layer's did not (had ssm_au_d
# instead). A cookie captured from a runtime page (/run/v2/...) generally
# won't include IQP_SITE, due to cookie path scoping — even in the same
# browser session.
#
# How to get this value: navigate to the Flows/Composer management area in
# your browser (a page under /iqp/ — the same area where you'd manage/list
# flows), open DevTools → Network, find a request to that domain, and copy
# its Cookie header the same way as above. If left blank, falls back to
# OPHUB_COOKIE (works fine if your environment doesn't need the distinction).
OPHUB_SITE_COOKIE=

# ── Optional: Origin/Referer overrides ───────────────────────────────────────
# Default to OPHUB_BASE_URL if not set. If requests still fail with these
# defaults, try setting OPHUB_REFERER to the exact page URL from a real
# request you've captured in DevTools (Request Headers → Referer) — some
# backends validate the referer points at a specific known page/app path, not
# just the right domain.
# OPHUB_ORIGIN=https://mes.gedemo.io
# OPHUB_REFERER=https://mes.gedemo.io/run/v2/app-name/_HMI%20Screens/page-name/NuclearPartial

# ── ThingWorx (for ThingWorx connections in Aetherium) ──────────────────────
# The server's base URL, without /Thingworx on the end.
TWX_BASE_URL=https://pp-2605181716jy.portal.ptc.io

# An Application Key: Composer → Browse → Security → Application Keys → New.
# Set its "User Name Reference" (the user whose permissions it runs with) and
# an expiration date, then copy the Key ID here. Same rules as the cookie:
# it's a credential — don't commit it or paste it anywhere.
TWX_APP_KEY=
