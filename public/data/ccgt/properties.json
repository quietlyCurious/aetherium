   "assetType": "hrsg",
   "property": "total_steam_flow_klb_h",
   "fn": "formula",
   "note": "HP + IP + LP steam flow (IP ≈ 16% and LP ≈ 13% of HP at these loads)"
  },
  {
   "assetType": "scr_system",
